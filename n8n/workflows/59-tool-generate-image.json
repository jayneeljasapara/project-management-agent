{
  "name": "59 - TOOL - generate_image",
  "nodes": [
    {
      "parameters": {
        "content": "## On-demand picture for a post\nMakes one picture from a description the current user asked for, using the reviewed Higgsfield endpoint and your own stored credential.\n\nIt saves the picture into this conversation and shows it in the chat. It never publishes anywhere, never posts to social, and never runs on a schedule. A refusal or a failure is reported plainly instead of being retried.",
        "height": 320,
        "width": 620,
        "color": 4
      },
      "type": "n8n-nodes-base.stickyNote",
