    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "language": "javaScript",
        "jsCode": "const input=$('Validate Image Request').first().json;\nconst saved=$json.image;\nconst ok=Boolean(saved&&saved.downloadUrl);\nconst response=ok\n  ?{ok:true,savedImage:true,prompt:input.prompt,aspectRatio:input.aspectRatio,\n     downloadUrl:saved.downloadUrl,imageId:saved.imageId,\n     message:'The picture is saved and shown in the chat. Nothing was published anywhere.'}\n  :{ok:false,savedImage:false,error:{code:'IMAGE_NOT_SAVED',message:'The picture was made but could not be saved locally.'}};\nreturn {json:{response}};"
      },
