      ],
      "id": "a1400000-0000-4000-8000-000000000003",
      "name": "Request Higgsfield Image",
      "credentials": {
        "httpHeaderAuth": {
          "id": "phase14Higgsfield",
          "name": "Higgsfield API"
        }
      }
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "language": "javaScript",
        "jsCode": "const b=$json;\nconst requestIdRemote=typeof b.request_id==='string'?b.request_id:'';\nconst statusUrl=typeof b.status_url==='string'?b.status_url:'';\nconst ok=Boolean(requestIdRemote)&&/^https:\\/\\/platform\\.higgsfield\\.ai\\/requests\\//.test(statusUrl);\nreturn {json:{submitted:ok,statusUrl,remoteRequestId:requestIdRemote,attempts:0,\n  ...(ok?{}:{response:{ok:false,error:{code:'IMAGE_PROVIDER_UNAVAILABLE',message:'The picture service did not accept the request. Nothing was charged for a picture that was not made.'}}})}};"
      },
      "type": "n8n-nodes-base.code",
