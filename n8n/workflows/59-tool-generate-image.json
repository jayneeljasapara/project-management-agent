      "name": "Wait For Picture",
      "webhookId": "a1400000-0000-4000-8000-000000000099"
    },
    {
      "parameters": {
        "url": "={{ $('Check Submission').first().json.statusUrl }}",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "options": {
          "response": {
            "response": {
              "neverError": true
            }
          }
        }
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1280,
        360
      ],
      "id": "a1400000-0000-4000-8000-000000000005",
      "name": "Poll Picture Status",
      "credentials": {
        "httpHeaderAuth": {
          "id": "phase14Higgsfield",
          "name": "Higgsfield API"
        }
      }
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "language": "javaScript",
        "jsCode": "const prev=$('Check Submission').first().json;\nconst attempts=Number($json.attempts??prev.attempts??0)+1;\nconst s=$json;\nconst status=typeof s.status==='string'?s.status:'unknown';\nconst terminal=['completed','failed','nsfw','canceled'].includes(status);\nconst imageUrl=Array.isArray(s.images)&&s.images[0]&&typeof s.images[0].url==='string'?s.images[0].url:'';\n// 40 polls at 5 seconds is a little over three minutes, then we stop and say so\n// rather than leaving the request hanging.\nconst exhausted=attempts>=40;\nconst done=terminal||exhausted;\nlet response=null;\nif(status==='completed'&&imageUrl){response=null;}\nelse if(status==='nsfw'){response={ok:false,error:{code:'IMAGE_REJECTED',message:'The picture service refused that description. Try describing it differently.'}};}\nelse if(status==='failed'||status==='canceled'){response={ok:false,error:{code:'IMAGE_FAILED',message:'The picture could not be made. Nothing was saved.'}};}\nelse if(exhausted){response={ok:false,error:{code:'IMAGE_TIMED_OUT',message:'The picture is taking longer than expected. Ask again in a moment.'}};}\nelse if(terminal&&!imageUrl){response={ok:false,error:{code:'IMAGE_MISSING',message:'The picture service finished without returning a picture.'}};}\nreturn {json:{attempts,status,statusUrl:prev.statusUrl,imageUrl,done,ready:status==='completed'&&Boolean(imageUrl),...(response?{response}:{})}};"
      },
