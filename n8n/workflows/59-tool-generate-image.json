          },
          "conditions": [
            {
              "id": "b140-submitted",
              "leftValue": "={{ $json.submitted }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
