        "language": "javaScript",
        "jsCode": "const i=$('Validate Image Request').first().json,r=$json.response??{ok:false,error:{code:'IMAGE_FAILED',message:'The picture could not be made.'}};return{json:{occurredAt:new Date().toISOString(),sessionId:i.sessionId,requestId:i.requestId,toolName:'generate_image',proposedInput:JSON.stringify({prompt:i.prompt,aspectRatio:i.aspectRatio,jobId:i.jobId}),result:JSON.stringify(r),error:r.ok===false?String(r.error?.message??'Tool failed'):'',response:r}};"
      },
