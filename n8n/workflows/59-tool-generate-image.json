    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://platform.higgsfield.ai/higgsfield-ai/soul/standard",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ prompt: $json.prompt, aspect_ratio: $json.aspectRatio, resolution: '1080p' }) }}",
        "options": {
          "response": {
