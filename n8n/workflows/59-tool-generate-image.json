    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "language": "javaScript",
        "jsCode": "const sessionId=typeof $json.sessionId==='string'?$json.sessionId.trim():'';\nconst requestId=typeof $json.requestId==='string'?$json.requestId.trim():'';\nconst rawPrompt=typeof $json.prompt==='string'?$json.prompt.trim():'';\nconst jobId=typeof $json.jobId==='string'?$json.jobId.trim():'';\nconst rawRatio=typeof $json.aspectRatio==='string'&&$json.aspectRatio.trim()?$json.aspectRatio.trim():'16:9';\nconst uuid=/^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/i;\nconst ratios=['1:1','16:9','9:16','4:3','3:4','3:2','2:3'];\nlet error=null;\nif(!uuid.test(sessionId)||!uuid.test(requestId)){error={code:'INVALID_SESSION',message:'The image request needs a valid conversation and request ID.'};}\nelse if(rawPrompt.length<3){error={code:'PROMPT_REQUIRED',message:'Describe the picture you want in a sentence or two.'};}\nelse if(rawPrompt.length>2000){error={code:'PROMPT_TOO_LONG',message:'Keep the picture description under 2000 characters.'};}\nelse if(!ratios.includes(rawRatio)){error={code:'INVALID_ASPECT_RATIO',message:'Use one of 1:1, 16:9, 9:16, 4:3, 3:4, 3:2 or 2:3.'};}\n// Researched pages and article text are untrusted data. A prompt is a description\n// of a picture, never an instruction to the agent or the provider.\nconst prompt=rawPrompt.replace(/[\\u0000-\\u001f\\u007f]/g,' ').replace(/\\s+/g,' ').trim();\nconst proposedInput={sessionId,requestId,prompt,aspectRatio:rawRatio,jobId};\nreturn {json:{valid:error===null,...proposedInput,proposedInput,...(error?{response:{ok:false,error}}:{})}};"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -40,
        560
      ],
      "id": "c1400000-0000-4000-8000-000000000-40",
